{
  "name": "jspsych-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.tools.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "node -e \"console.error('Use db:migrate:demo explicitly'); process.exit(1)\"",
    "test:api": "node --experimental-strip-types scripts/verify-api.ts local",
    "test:volume": "node --experimental-strip-types scripts/verify-volume.ts",
    "deploy": "node -e \"console.error('Use deploy:demo explicitly'); process.exit(1)\"",
    "deploy:demo": "CLOUDFLARE_ENV=demo npm run build && wrangler deploy --env demo",
    "db:migrate:demo": "wrangler d1 migrations apply DB --remote --env demo",
    "data:export": "node --experimental-strip-types scripts/export-data.ts",
    "test:e2e": "playwright test",
    "smoke": "node --experimental-strip-types scripts/smoke-test.ts"
  },
  "dependencies": {
    "@jspsych/plugin-html-button-response": "2.1.0",
    "@jspsych/plugin-survey-likert": "2.2.0",
    "jspsych": "8.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.7",
    "@cloudflare/workers-types": "5.20260910.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "wrangler": "4.131.0"
  }
}
